{
  // Typecheck-only. tsup owns the build — it emits the bundles, sourcemaps and
  // .d.ts from tsup.config.ts, and ignores the emit options here. Type-level
  // options (notably `stripInternal`) ARE read by its .d.ts step.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    // Erases `@internal` members — `OCPIClient._build` and `OCPPClient._build`
    // are construction details `startOCPI`/`startOCPP` own, not public API.
    "stripInternal": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // The tests are typechecked too. They are the first consumer of the public
  // API, so a rename that leaves one behind should fail the typecheck rather
  // than surface later as a runtime assertion.
  "include": ["src", "test"]
}

{
  // Typecheck-only. tsup owns the build — it emits the bundles, sourcemaps and
  // .d.ts from tsup.config.ts, and ignores the emit options here. Type-level
  // options (notably `stripInternal`) ARE read by its .d.ts step.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    // Erases `@internal` members (e.g. OCPIClient#_internal) from the emitted
    // .d.ts — the adapter channel must not appear in the public typings.
    "stripInternal": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
